# =============================================================================
#  FRONTEND environment
#  Copy to .env.local  ->  cp .env.local.example .env.local
# =============================================================================

# Where your Express backend is running.
#
# NEXT_PUBLIC_ prefix means this value is embedded into the JavaScript sent to
# the browser. That is correct here (the browser needs to know where to send
# requests) but it also means ANYONE CAN READ IT. Never prefix a secret with
# NEXT_PUBLIC_ — no admin keys, no service_role keys, nothing private.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Your store name, shown in the header and page titles.
NEXT_PUBLIC_STORE_NAME=Tech Store
