# =============================================================================
#  TECH STORE BACKEND — environment variables
#  Copy this file to `.env` and fill in the real values:
#      cp .env.example .env
#  `.env` is gitignored. NEVER commit it.
# =============================================================================

# --- Server ------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- CORS --------------------------------------------------------------------
# Where your React app runs. Falls back to http://localhost:3000 if unset.
# For multiple origins, separate with commas (no spaces):
#   FRONTEND_URL=http://localhost:3000,https://mystore.com
FRONTEND_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# The `service_role` key, NOT the `anon` key.
# It bypasses Row Level Security and can read/write every table.
# It must never appear in frontend code, a git commit, or a screenshot.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage bucket created by db/03_security.sql
SUPABASE_STORAGE_BUCKET=product-images

# --- Brevo (transactional email) ---------------------------------------------
# app.brevo.com -> SMTP & API -> API Keys -> Generate a new API key (v3)
BREVO_API_KEY=your-brevo-api-key-here

# The sender must be a VERIFIED sender in Brevo, or every send is rejected.
# Brevo -> Senders, Domains & Dedicated IPs -> Senders
BREVO_SENDER_EMAIL=noreply@yourstore.com
BREVO_SENDER_NAME=Tech Store

# Where contact-form alerts are delivered.
ADMIN_EMAIL=admin@yourstore.com

# Set to false to skip all sending while developing (emails are logged instead).
EMAIL_ENABLED=true

# --- Admin authentication ----------------------------------------------------
# Sent by your admin dashboard as the `x-admin-key` header on /api/admin/* calls.
# Generate a strong one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=generate-a-long-random-string-here

# --- Store details (used in email templates) ---------------------------------
# NOTE: the delivery fee, free-delivery threshold, currency and the checkout
# on/off switch are NOT here. They live in the store_settings table so you can
# change them from the admin panel without a redeploy:
#     PATCH /api/admin/settings   { "delivery_fee": 5 }
#
# This store is CASH ON DELIVERY. There are no payment gateway keys because the
# site never touches money — the courier collects it at the door.
STORE_NAME=Tech Store
STORE_URL=http://localhost:3000
STORE_SUPPORT_EMAIL=support@yourstore.com
